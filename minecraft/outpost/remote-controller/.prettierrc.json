{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-jsdoc"],
  "jsdocLineWrappingStyle": "greedy",
  "overrides": [
    {
      "files": "**/*.md",
      "options": {
        "proseWrap": "never"
      }
    },
    {
      "files": "**/*.ts",
      "options": {
        "printWidth": 80,
        "tabWidth": 4
      }
    }
  ]
}
