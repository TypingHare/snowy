{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 80,
  "tabWidth": 4,
  "useTabs": false,
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-jsdoc"],
  "jsdocLineWrappingStyle": "greedy",
  "overrides": [
    {
      "files": "**/*.md",
      "options": {
        "proseWrap": "never"
      }
    }
  ]
}
